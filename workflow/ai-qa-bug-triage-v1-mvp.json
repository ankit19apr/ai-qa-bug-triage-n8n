    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Simulated existing bugs\nconst existingBugs = [\n  {\n    bugTitle: \"Login button not working\",\n    component: \"Login\"\n  },\n  {\n    bugTitle: \"Checkout page loading slowly\",\n    component: \"Checkout\"\n  },\n  {\n    bugTitle: \"Password reset email not received\",\n    component: \"Forgot Password\"\n  }\n];\n\nreturn items.map(item => {\n  const bug = item.json;\n\n  const duplicate = existingBugs.some(existing =>\n    existing.bugTitle.toLowerCase() === bug.bugTitle.toLowerCase() &&\n    existing.component.toLowerCase() === bug.component.toLowerCase()\n  );\n\n  return {\n    json: {\n      ...bug,\n      duplicateFound: duplicate,\n      duplicateStatus: duplicate ? \"DUPLICATE\" : \"NEW\"\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
